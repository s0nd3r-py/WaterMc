+    // WaterMc start - async /locate (idea: DivineMC, BX-Team, GPL-3.0), restricted to safe cases
+    // Only a player or the console without a result callback (no /execute store, not a command block or function):
+    // the command returns 0 at once and the answer is sent from the main thread when the search finishes.
+    private static boolean waterLocateAsync(CommandSourceStack source) {
+        return me.s0nd3r.watermc.core.config.modules.async.AsyncLocate.enabled
+            && source.callback() == net.minecraft.commands.CommandResultCallback.EMPTY
+            && (source.getEntity() instanceof net.minecraft.server.level.ServerPlayer || source.source instanceof net.minecraft.server.MinecraftServer);
+    }
+
+    private interface WaterLocateSearch {
+        int run() throws CommandSyntaxException;
+    }
+
+    private static int waterRunLocate(CommandSourceStack source, WaterLocateSearch search) throws CommandSyntaxException {
+        if (!waterLocateAsync(source)) {
+            return search.run();
+        }
+        io.papermc.paper.util.MCUtil.scheduleAsyncTask(() -> {
+            try {
+                search.run();
+            } catch (CommandSyntaxException ex) {
+                source.getServer().execute(() -> source.sendFailure(net.minecraft.network.chat.ComponentUtils.fromMessage(ex.getRawMessage())));
+            } catch (Throwable t) {
+                LOGGER.error("Async /locate failed", t);
+                source.getServer().execute(() -> source.sendFailure(Component.literal("Locate failed: " + t)));
+            }
+        });
+        return 0;
+    }
+    // WaterMc end
+
+    /** Messages go out from the main thread (they are also broadcast to operators). */
+    private static int waterShow(CommandSourceStack source, java.util.function.IntSupplier show) {
+        if (ca.spottedleaf.moonrise.common.util.TickThread.isTickThread()) { // synchronous path (main or a world thread): unchanged behaviour
+            return show.getAsInt();
+        }
+        source.getServer().execute(show::getAsInt);
+        return 0;
+    }
+
