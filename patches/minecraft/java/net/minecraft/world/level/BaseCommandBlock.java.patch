+    // WaterMc start - command block parse cache
+    // The parsed tree is reused only while the command text, the dispatcher and the root node of the command's
+    // first word are the same objects as at parse time (a plugin re-registering the command replaces that node).
+    // Each run puts the fresh source into the cached context, as vanilla functions reuse parsed commands.
+    private @Nullable String waterParsedCommand;
+    private com.mojang.brigadier.@Nullable ParseResults<CommandSourceStack> waterParsed;
+    private com.mojang.brigadier.@Nullable CommandDispatcher<CommandSourceStack> waterParsedDispatcher;
+    private com.mojang.brigadier.tree.@Nullable CommandNode<CommandSourceStack> waterParsedHead;
+
+    private void waterPerformCached(ServerLevel level, CommandSourceStack source, String command) {
+        final net.minecraft.commands.Commands commands = level.getServer().getCommands();
+        final com.mojang.brigadier.CommandDispatcher<CommandSourceStack> dispatcher = commands.getDispatcher();
+        final int space = command.indexOf(' ');
+        final com.mojang.brigadier.tree.CommandNode<CommandSourceStack> head = dispatcher.getRoot().getChild(space < 0 ? command : command.substring(0, space));
+        com.mojang.brigadier.ParseResults<CommandSourceStack> parsed = this.waterParsed;
+        if (parsed == null || dispatcher != this.waterParsedDispatcher || head != this.waterParsedHead || !command.equals(this.waterParsedCommand)) {
+            parsed = dispatcher.parse(command, source);
+            this.waterParsed = parsed;
+            this.waterParsedCommand = command;
+            this.waterParsedDispatcher = dispatcher;
+            this.waterParsedHead = head;
+        } else {
+            parsed.getContext().withSource(source);
+        }
+        commands.performCommand(parsed, command);
+    }
+    // WaterMc end
+
